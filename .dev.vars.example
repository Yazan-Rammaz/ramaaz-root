# Copy to .dev.vars and fill in. Documents required env for local dev.

# Base URL of the remote backend (auth + the systems registry). Must include
# the scheme — http:// or https://. Optional: leave it out and the dashboard
# runs with no backend (screens render, data calls fail with one clear error).
NEST_API_URL="https://staging-backend.ramaaz.store"

# Nothing else is needed. Sign-in carries no build-time credential: the access
# link's token arrives in the URL at /enter/<token> and is exchanged for a
# challenge — see src/lib/auth/link.ts.

# Unlocks /design in a DEPLOYED environment. Leave unset locally — the gallery
# is always on in development. In production set it as a Cloudflare SECRET
# (`npx wrangler secret put DESIGN_GALLERY_KEY`), never as a wrangler.jsonc
# `vars` entry: a vars entry shadows a secret of the same name, and would commit
# the value. Unlock a device once at /design/unlock?key=<value>.
DESIGN_GALLERY_KEY=""

# Unlocks the liveness bench at /design/liveness-lab — runs the real AWS Face
# Liveness check with no sign-in around it, so a spoof can be attempted over and
# over. Must match LIVENESS_LAB_SECRET on the ramaaz-kyc worker. Unset on both
# sides = the routes 404 and the bench is gone. Each run costs one check.
LIVENESS_LAB_SECRET=""
