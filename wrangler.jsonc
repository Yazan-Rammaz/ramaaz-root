{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "canroot",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    // The backend base URL is a public hostname, not a credential — it is
    // already committed in .dev.vars.example — so it lives here rather than as
    // a secret. A `vars` entry would in any case shadow a secret of the same
    // name, which is how the old placeholder ("https://yourdomain.com") could
    // have silently overridden a correctly-set secret.
    "NEST_API_URL": "https://staging-backend.ramaaz.store",
    // Which AWS region Face Liveness sessions stream to. Read ONLY by the CSP
    // in src/middleware.ts, which names that host explicitly because the
    // browser streams the selfie video straight to AWS.
    //
    // ⚠️ MUST MATCH the region the KYC Worker mints sessions in — see the long
    // note at `livenessRegion()`. Different values means the policy refuses the
    // socket the component just signed, and the check fails with nothing in the
    // network tab to explain it.
    //
    // Distance to this region is the dominant cost of the whole check: the
    // video upload is a real megabytes-over-the-wire transfer, not a signal.
    "KYC_LIVENESS_REGION": "us-east-1",
    // The WebAuthn RP ID the lock screens' passkey is offered under. A runtime
    // var (read with cfEnv), so changing it needs no rebuild.
    //
    // ⚠️ It does NOT choose the RP ID: the backend does, inside the options it
    // issues. This decides only whether to OFFER the passkey on this host —
    // it is hidden unless the page's host is this value or a subdomain of it.
    // Keep it equal to the backend's RP ID, or the ceremony fails with a
    // SecurityError.
    // Local tunnels override it in .dev.vars / .env.local, never here.
    "WEBAUTHN_RP_ID": "canroot.yazan-adnof.workers.dev"
  },
  // Service binding to the KYC Worker.
  //
  // ⚠️ REQUIRED on Cloudflare, not an optimisation. A same-account
  // Worker→Worker fetch over a *.workers.dev URL never reaches the target
  // Worker — Cloudflare answers its own bare 404 page instead. Plain fetch
  // works in `next dev`, so without this the KYC proxy passes locally and
  // 404s only once deployed.
  //
  // Both Workers must be in the same Cloudflare account; both are in
  // yazan-adnof, so this resolves.
  "services": [{ "binding": "KYC_WORKER", "service": "ramaaz-kyc" }],

  // The BROWSER reports its own failures straight to `ramaaz-observe` — see
  // src/config/observe.ts, and the connect-src note in middleware.ts for why
  // that one origin is named in the CSP.
  //
  // Nothing server-side is involved, so there is no binding and no secret for
  // it here. `observability` below captures this Worker and the KYC Worker
  // captures itself; neither can see the browser, and the browser is where the
  // camera is — a liveness detector that refuses to start reaches
  // `console.error` on a tablet and is gone the moment the tab closes. That
  // happened, and answering "why" cost a day.

  // Retain logs, rather than requiring somebody to be watching.
  //
  // Without this, `console.log` output exists only while a `wrangler tail` is
  // attached — so a failed run is diagnosable only if a tail happened to be
  // connected at that second, and otherwise the evidence is simply gone. That
  // cost several sign-in attempts during the KYC integration, and attempts are
  // scarce: a challenge tolerates five failures and then burns.
  //
  // The KYC Worker has had this from the start (`[observability.logs]` in its
  // wrangler.toml), which is why that half of the system was always readable
  // and this half was not.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
