{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "canroot",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    // The backend base URL is a public hostname, not a credential — it is
    // already committed in .dev.vars.example — so it lives here rather than as
    // a secret. A `vars` entry would in any case shadow a secret of the same
    // name, which is how the old placeholder ("https://yourdomain.com") could
    // have silently overridden a correctly-set secret.
    "NEST_API_URL": "https://staging-backend.ramaaz.store"
  },
  // Service binding to the KYC Worker.
  //
  // ⚠️ REQUIRED on Cloudflare, not an optimisation. A same-account
  // Worker→Worker fetch over a *.workers.dev URL never reaches the target
  // Worker — Cloudflare answers its own bare 404 page instead. Plain fetch
  // works in `next dev`, so without this the KYC proxy passes locally and
  // 404s only once deployed.
  //
  // Both Workers must be in the same Cloudflare account; both are in
  // yazan-adnof, so this resolves.
  "services": [{ "binding": "KYC_WORKER", "service": "ramaaz-kyc" }],

  // Where the BROWSER's account of a failure is kept — see src/lib/diag.
  //
  // `observability` below captures this Worker, and the KYC Worker captures
  // itself. Neither can see the browser, and the browser is where the camera
  // is: a liveness detector that refuses to start reaches `console.error` on a
  // tablet and is gone the moment the tab closes. That happened, and answering
  // "why" cost a day and still needed a log pasted by hand.
  //
  // Keyed by challenge id, so a backend log line quoting a challenge is enough
  // to pull the browser side of the same sign-in. 30-day TTL, metadata only.
  "kv_namespaces": [{ "binding": "DIAG", "id": "88fa2da5cd6f4c11b3e9e862aa977b6e" }],

  // Retain logs, rather than requiring somebody to be watching.
  //
  // Without this, `console.log` output exists only while a `wrangler tail` is
  // attached — so a failed run is diagnosable only if a tail happened to be
  // connected at that second, and otherwise the evidence is simply gone. That
  // cost several sign-in attempts during the KYC integration, and attempts are
  // scarce: a challenge tolerates five failures and then burns.
  //
  // The KYC Worker has had this from the start (`[observability.logs]` in its
  // wrangler.toml), which is why that half of the system was always readable
  // and this half was not.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
